# Cloudflare Pages / Netlify response headers. GitHub Pages ignores this file.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Join links carry a team code: never indexed.
/join/*
  X-Robots-Tag: noindex

/en/join/*
  X-Robots-Tag: noindex

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/screens/*
  Cache-Control: public, max-age=604800

# Email links carry a one-time token: never indexed, never sent on as a referrer.
/invite/*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer

/reset-password*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer

/verify-email*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
